{
  "name": "utsav-event-planner",
  "version": "1.0.0",
  "description": "Utsav — a GenAI-powered celebration & event planner for weddings, birthdays and community events (budgets, timelines, vendor checklists and personalised ideas) built on Google Gemini.",
  "type": "module",
  "main": "server.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" \"tests/**/*.test.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
