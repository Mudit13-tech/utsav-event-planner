# Copy to .env for local development (never commit .env).
# Option A — Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Option B — Vertex AI on Google Cloud (uses the service account; no key needed)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional tuning
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=40000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
PORT=8080
